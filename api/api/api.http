@api_HostAddress = http://localhost:5055

GET {{api_HostAddress}}/weatherforecast/
Accept: application/json

###

# --- Auth ---

POST {{api_HostAddress}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123",
  "displayName": "Test User"
}

###

POST {{api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123"
}

###

# Sau login/register, JWT được đặt trong HttpOnly cookie "auth_token"
# (xem header Set-Cookie của response), không còn trong body.
# Nếu client giữ cookie thì /auth/me chạy luôn không cần header.
# Cách test thay thế: dán token đọc từ cookie vào đây và dùng Bearer
# (middleware vẫn chấp nhận header Authorization).
@token = PASTE_TOKEN_HERE

GET {{api_HostAddress}}/auth/me
Authorization: Bearer {{token}}

###

POST {{api_HostAddress}}/auth/logout

###
