# Copy thành .env trên server:  cp .env.example .env && chmod 600 .env
# .env chứa secret — KHÔNG commit (đã có trong deploy/.gitignore).
# Sinh secret ngẫu nhiên:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

# --- Domain & TLS ---
# Domain phải trỏ (bản ghi A) về IP server TRƯỚC khi chạy, nếu không Caddy không xin được cert.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# --- Image ---
# Registry + tag của image cần chạy. scripts/deploy.sh tự cập nhật TAG.
IMAGE_PREFIX=ghcr.io/your-github-user/your-repo
TAG=latest

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=webapp
# User sở hữu schema — Flyway dùng để migrate.
MYSQL_USER=webapp_migrator
MYSQL_PASSWORD=change-me
# User API dùng lúc chạy — chỉ SELECT/INSERT/UPDATE/DELETE.
APP_DB_USER=webapp_app
APP_DB_PASSWORD=change-me

# --- JWT ---
# Ít nhất 32 ký tự ngẫu nhiên. Đổi key ⇒ mọi người dùng bị đăng xuất.
JWT_KEY=change-me-to-a-random-string-of-at-least-32-chars
JWT_ISSUER=webapp-starterkit
JWT_AUDIENCE=webapp-starterkit
