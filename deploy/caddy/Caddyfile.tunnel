# Chế độ TUNNEL (Cloudflare Tunnel — xem docker-compose.tunnel.yml).
# Cloudflare lo HTTPS với trình duyệt; cloudflared mang request qua đường hầm tới
# caddy:80 trong mạng Docker. Không cổng nào mở ra ngoài, nên Caddy chỉ cần HTTP
# và không xin cert.
{
	auto_https off
	servers {
		# Request chỉ đến từ container cloudflared (IP nội bộ của Docker), nên tin
		# header của nó để lấy IP thật của người dùng thay vì IP của cloudflared.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}
}

:80 {
	import app.caddy
}
