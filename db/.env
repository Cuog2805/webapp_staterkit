# docker-compose.yml reads these variables to configure the MySQL container.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=webapp_db
MYSQL_USER=webapp_db
MYSQL_PASSWORD=webapp@123
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- Connection string (built from the values above) ---
# Backend (ASP.NET) / app consumers can read this directly.
DATABASE_URL=mysql://webapp:change-me@localhost:3306/webapp
